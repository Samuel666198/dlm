{
  "manifest_version": 3,
  "name": "dlm Download Companion",
  "version": "0.2.11",
  "description": "网页右键/点击下载链接/媒体与文件嗅探 → dlm 本地下载器",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-0.2.11.js"
  },
  "action": {
    "default_title": "dlm",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
