{
  "manifest_version": 3,
  "name": "dlm Native Ping",
  "version": "0.1.0",
  "description": "B1: ping the dlm native messaging host and show the pong on every page.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "dlm native ping" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
